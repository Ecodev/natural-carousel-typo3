<T3DataStructure>
    <sheets>
        <selection>
            <ROOT>
                    <sheetTitle>LLL:EXT:natural_carousel/Resources/Private/Language/locallang.xlf:flexform.tab.source
                    </sheetTitle>
                <type>array</type>
                <el>
                    <images>
                            <label>LLL:EXT:core/Resources/Private/Language/locallang_general.xlf:LGL.images</label>
                            <config>
                                <type>file</type>
                                <allowed>common-image-types</allowed>
                                <maxitems>100</maxitems>
                                <minitems>0</minitems>
                                <appearance type="array">
                                    <createNewRelationLinkTitle>LLL:EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:images.addFileReference</createNewRelationLinkTitle>
                                    <showPossibleLocalizationRecords>1</showPossibleLocalizationRecords>
                                </appearance>
                            </config>
                    </images>
                </el>
            </ROOT>
        </selection>

        <sorting>
            <ROOT>
                    <sheetTitle>LLL:EXT:natural_carousel/Resources/Private/Language/locallang.xlf:flexform.tab.sorting
                    </sheetTitle>
                <type>array</type>
                <el>
                </el>
            </ROOT>
        </sorting>

        <slideSettings>
            <ROOT>
                    <sheetTitle>Slide settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.autoplay>
                            <label>
                                Wait time
                            </label>
                            <config>
                                <type>input</type>
                                <eval>trim</eval>
                            </config>
                    </settings.autoplay>
                    <settings.speed>
                            <label>Transition time</label>
                            <config>
                                <type>input</type>
                                <eval>trim</eval>
                            </config>
                    </settings.speed>
                    <settings.loop>
                            <label>
                                Loop
                            </label>
                            <config>
                                <type>check</type>
                                <default>1</default>
                            </config>
                    </settings.loop>

                    <settings.blur>
                            <label>
                                Blur
                            </label>
                            <config>
                                <type>check</type>
                                <default>0</default>
                            </config>
                    </settings.blur>
                    <settings.effect>
                            <label>
                                Effect
                            </label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="1" type="array">
                                        <numIndex index="0">
                                            coverflow
                                        </numIndex>
                                        <numIndex index="1">coverflow</numIndex>
                                    </numIndex>
                                    <numIndex index="2" type="array">
                                        <numIndex index="0">
                                            slide
                                        </numIndex>
                                        <numIndex index="1">slide</numIndex>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <numIndex index="0">
                                            cube
                                        </numIndex>
                                        <numIndex index="1">cube</numIndex>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <numIndex index="0">
                                            fade
                                        </numIndex>
                                        <numIndex index="1">fade</numIndex>
                                    </numIndex>
                                    <numIndex index="5" type="array">
                                        <numIndex index="0">
                                            flip
                                        </numIndex>
                                        <numIndex index="1">flip</numIndex>
                                    </numIndex>
                                </items>
                                <minitems>0</minitems>
                                <maxitems>1</maxitems>
                            </config>
                    </settings.effect>
                    <settings.slidesPerView>
                            <label>
                                Slides per view
                            </label>
                            <config>
                                <type>input</type>
                                <default>1</default>
                                <eval>trim</eval>
                            </config>
                    </settings.slidesPerView>
                    <settings.slideHeight>
                            <label>
                                Slide height
                            </label>
                            <config>
                                <type>input</type>
                                <default>400</default>
                                <eval>trim</eval>
                            </config>
                    </settings.slideHeight>
                </el>
            </ROOT>
        </slideSettings>
    </sheets>
</T3DataStructure>
